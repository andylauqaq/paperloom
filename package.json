{
  "name": "paperloom",
  "version": "0.2.1",
  "private": true,
  "description": "纸序 Paperloom — 本地 AI 文献整理工具",
  "type": "module",
  "main": "desktop/main.mjs",
  "author": "Paperloom contributors",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/build-mcp.mjs",
    "start": "npm run build && electron .",
    "test": "node --test tests/core.test.mjs tests/bridge.test.mjs",
    "test:desktop": "npm run build && node tests/desktop.test.mjs",
    "mcp": "node desktop/mcp-entry.mjs",
    "package:win": "npm run build && electron-builder --win nsis zip --x64"
  },
  "build": {
    "appId": "local.paperloom.desktop",
    "productName": "Paperloom",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "core/**/*",
      "package.json"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "dist-mcp",
        "to": "mcp"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "signAndEditExecutable": false,
      "artifactName": "Paperloom-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Paperloom-Setup-${version}-${arch}.exe"
    }
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@modelcontextprotocol/server": "2.4.0",
    "chokidar": "5.0.0",
    "lucide-react": "1.72.0",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "overrides": {
    "app-builder-lib": {
      "minimatch": "11.0.8"
    },
    "@electron/universal": {
      "minimatch": "11.0.8"
    }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.1",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "pdf-lib": "1.17.1",
    "playwright": "1.65.0",
    "prettier": "3.10.1",
    "vite": "8.3.8"
  }
}
